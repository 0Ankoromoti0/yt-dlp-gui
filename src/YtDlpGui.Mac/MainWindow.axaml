<Window x:Class="YtDlpGui.MainWindow"
 xmlns="https://github.com/avaloniaui"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="yt-dlp GUI" Width="1100" Height="850" MinWidth="960" MinHeight="700"
 Background="#F4F6FA" Foreground="{StaticResource Ink}" FontFamily="Hiragino Sans, Yu Gothic UI, Segoe UI" FontSize="13"
 WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
 <Grid Background="#F4F6FA">
  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <Border Background="White" BorderBrush="#E4E8F0" BorderThickness="0,0,0,1" Padding="30,20">
   <Grid>
    <StackPanel Orientation="Horizontal">
     <Border Width="42" Height="42" Background="{StaticResource Accent}" CornerRadius="12" Margin="0,0,14,0">
      <Path Stroke="White" StrokeThickness="2.4" StrokeLineCap="Round" Data="M21,10 L21,26 M15,20 L21,26 L27,20 M12,28 L12,33 L30,33 L30,28" />
     </Border>
     <StackPanel VerticalAlignment="Center">
      <TextBlock Text="yt-dlp GUI" FontSize="22" FontWeight="Bold" />
      <TextBlock Text="動画と音声を、好きなかたちで。" Classes="Caption" />
     </StackPanel>
    </StackPanel>
    <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#F0F4FF" CornerRadius="16" Padding="13,7">
     <TextBlock Text="macOS  ·  v1.1" FontSize="11" Foreground="#50628F" FontWeight="SemiBold" />
    </Border>
   </Grid>
  </Border>

  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <Grid Margin="30,26,30,24">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="22" /><ColumnDefinition Width="325" /></Grid.ColumnDefinitions>
    <StackPanel Grid.Column="0">
     <TextBlock Text="ダウンロード" FontSize="27" FontWeight="Bold" Margin="0,0,0,5" />
     <TextBlock Text="URLを貼り付けて、取得できる品質を確認しましょう。" Classes="Caption" Margin="0,0,0,21" />

     <Border Classes="Card" Margin="0,0,0,16">
      <StackPanel>
       <TextBlock Text="01  /  URLを入力" Classes="FieldLabel" />
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" ToolTip.Tip="動画または音声のURL（http / https）" AutomationProperties.Name="動画・音声のURL">
         <TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding AnalyzeCommand}" /></TextBox.KeyBindings>
        </TextBox>
        <Button Grid.Column="2" Content="情報取得" Command="{Binding AnalyzeCommand}" Classes="PrimaryButton" />
       </Grid>
       <Border Background="#F6F8FD" CornerRadius="10" Padding="14" Margin="0,17,0,0">
        <StackPanel>
         <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="70" TextTrimming="CharacterEllipsis" />
         <TextBlock Text="{Binding Subtitle}" Classes="Caption" Margin="0,7,0,0" />
        </StackPanel>
       </Border>
      </StackPanel>
     </Border>

     <Border Classes="Card" Margin="0,0,0,16">
      <StackPanel>
       <TextBlock Text="02  /  形式と品質を選択" Classes="FieldLabel" />
       <Border Background="#EDF1F8" CornerRadius="10" Padding="4" Margin="0,4,0,21" IsEnabled="{Binding CanEdit}">
        <UniformGrid Columns="2">
         <RadioButton Content="動画" IsChecked="{Binding VideoMode}" GroupName="Mode" Classes="ModeButton" />
         <RadioButton Content="音声のみ" IsChecked="{Binding AudioOnly}" GroupName="Mode" Classes="ModeButton" />
        </UniformGrid>
       </Border>
       <StackPanel IsVisible="{Binding VideoMode}" IsEnabled="{Binding CanEdit}">
        <TextBlock Text="保存形式" Classes="FieldLabel" />
        <ComboBox ItemsSource="{Binding VideoContainers}" DisplayMemberBinding="{Binding Label}" SelectedValueBinding="{Binding Value}" SelectedValue="{Binding VideoContainer}" AutomationProperties.Name="動画の保存形式" />
        <TextBlock Text="画質" Classes="FieldLabel" Margin="0,17,0,8" />
        <ComboBox ItemsSource="{Binding VideoChoices}" SelectedItem="{Binding SelectedVideo}" IsEnabled="{Binding HasMedia}" AutomationProperties.Name="動画の画質">
         <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
       </StackPanel>
       <StackPanel IsVisible="{Binding AudioOnly}" IsEnabled="{Binding CanEdit}">
        <TextBlock Text="取得元の音声" Classes="FieldLabel" />
        <ComboBox ItemsSource="{Binding AudioChoices}" SelectedItem="{Binding SelectedAudio}" IsEnabled="{Binding HasMedia}" AutomationProperties.Name="取得する音声">
         <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
        <Grid Margin="0,17,0,0">
         <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
         <StackPanel>
          <TextBlock Text="保存形式" Classes="FieldLabel" />
          <ComboBox ItemsSource="{Binding AudioOutputs}" DisplayMemberBinding="{Binding Label}" SelectedValueBinding="{Binding Value}" SelectedValue="{Binding AudioOutput}" AutomationProperties.Name="音声の保存形式" />
         </StackPanel>
         <StackPanel Grid.Column="2" IsVisible="{Binding ShowBitrate}">
          <TextBlock Text="変換ビットレート" Classes="FieldLabel" />
          <ComboBox ItemsSource="{Binding Bitrates}" SelectedItem="{Binding AudioBitrate}" AutomationProperties.Name="音声の変換ビットレート">
           <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat={}{0} kbps}" /></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
         </StackPanel>
        </Grid>
        <TextBlock Text="{Binding AudioHint}" Classes="Caption" Margin="0,12,0,0" />
       </StackPanel>
       <TextBlock Text="{Binding SelectionHint}" Classes="Caption" Margin="0,14,0,0" />
      </StackPanel>
     </Border>
     <Border Background="#FFF2F1" BorderBrush="#F3CECA" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,16" IsVisible="{Binding HasError}">
      <StackPanel>
       <TextBlock Text="処理を完了できませんでした" Foreground="#A63B32" FontWeight="SemiBold" Margin="0,0,0,6" />
       <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="#8F413A" FontSize="12" MaxHeight="160" TextTrimming="CharacterEllipsis" />
      </StackPanel>
     </Border>
     <Expander Header="詳細ログ" IsExpanded="False" Padding="4" Margin="0,0,0,12">
      <TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas, Yu Gothic UI" FontSize="11" Height="180" ScrollViewer.VerticalScrollBarVisibility="Auto" Margin="0,10,0,0" AutomationProperties.Name="詳細ログ" />
     </Expander>
    </StackPanel>

    <StackPanel Grid.Column="2" Margin="0,77,0,0">
     <Border Classes="Card" Margin="0,0,0,16">
      <StackPanel>
       <TextBlock Text="03  /  保存先" Classes="FieldLabel" />
       <TextBox Text="{Binding SaveDirectory, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="保存先フォルダー" ToolTip.Tip="{Binding SaveDirectory}" />
       <Button Content="フォルダーを選択…" Command="{Binding BrowseCommand}" Margin="0,10,0,0" />
       <TextBlock Text="出力ファイル" Classes="FieldLabel" Margin="0,22,0,8" />
       <TextBlock Text="{Binding OutputHint}" Classes="Caption" MaxHeight="80" TextTrimming="CharacterEllipsis" />
       <Border Height="1" Background="#E8ECF3" Margin="0,20,0,20" />
       <Button Content="↓  保存を開始" Command="{Binding DownloadCommand}" Classes="PrimaryButton" FontSize="15" MinHeight="49" />
       <Button Content="キャンセル" Command="{Binding CancelCommand}" Margin="0,9,0,0" IsVisible="{Binding IsBusy}" />
      </StackPanel>
     </Border>
     <Border Classes="Card" Margin="0,0,0,16">
      <StackPanel>
       <Grid>
        <TextBlock Text="{Binding Stage}" FontSize="14" FontWeight="SemiBold" />
        <TextBlock Text="{Binding PercentText}" HorizontalAlignment="Right" Foreground="{StaticResource Accent}" FontWeight="SemiBold" />
       </Grid>
       <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressValue, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate}" Height="7" Margin="0,17,0,10" Foreground="{StaticResource Accent}" Background="#E9EDF6" BorderThickness="0" />
       <Grid Margin="0,0,0,8">
        <TextBlock Text="{Binding SpeedText}" Classes="Caption" />
        <TextBlock Text="{Binding EtaText}" Classes="Caption" HorizontalAlignment="Right" />
       </Grid>
       <TextBlock Text="{Binding Status}" Classes="Caption" />
       <TextBlock Text="{Binding LastFile}" Classes="Caption" TextTrimming="CharacterEllipsis" MaxHeight="60" Margin="0,10,0,0" IsVisible="{Binding HasLastFile}" ToolTip.Tip="{Binding LastFile}" />
       <Button Content="保存先を開く ↗" Command="{Binding OpenFolderCommand}" Margin="0,16,0,0" />
      </StackPanel>
     </Border>
     <TextBlock Text="取得完了後に結合・変換を行います。処理が終わるまで、そのままお待ちください。" Classes="Caption" Margin="4,0,4,0" />
    </StackPanel>
   </Grid>
  </ScrollViewer>

  <Border Grid.Row="2" Background="White" BorderBrush="#E4E8F0" BorderThickness="0,1,0,0" Padding="30,12">
   <Expander Header="{Binding ToolSummary}" FontSize="12">
    <StackPanel Margin="0,10,0,0">
     <TextBox Text="{Binding ToolDetails, Mode=OneWay}" FontSize="11" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="200" ScrollViewer.VerticalScrollBarVisibility="Auto" />
     <WrapPanel Margin="0,10,0,0">
      <Button Content="再確認" Command="{Binding RefreshToolsCommand}" Margin="0,0,8,0" />
      <Button Content="yt-dlpを更新" Command="{Binding UpdateCommand}" Margin="0,0,8,0" />
      <Button Content="前のバージョンへ戻す" Command="{Binding RestoreCommand}" />
     </WrapPanel>
     <TextBlock Text="更新は同梱のyt-dlpのみが対象です。通信環境やサイトの変更で失敗する場合は、更新後に情報を再取得してください。" Classes="Caption" Margin="0,10,0,0" />
    </StackPanel>
   </Expander>
  </Border>
 </Grid>
</Window>


